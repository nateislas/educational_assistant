# OpenAI Configuration (Optional if using Google models)
OPENAI_API_KEY=your_openai_api_key_here

# Google GenAI / Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model & Judge Configuration (Optional, safe defaults used if omitted)
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
GEMINI_LLM_JUDGE=gemini-3.1-flash-lite
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=1000

# LangSmith Tracing & Evals
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=educational-assistant

# Exa Search (Optional)
EXA_API_KEY=your_exa_api_key_here
